# NovelWorkshop 环境变量配置
# 复制此文件为 .env 并填入你自己的真实密钥；.env 不纳入发布包。
# 安全提示：切勿将真实 API Key 提交到源码仓库或发布包中（R5 修复）。

# ============================================================
# DeepSeek API（性价比高，适合大量文本生成）
# 申请地址：https://platform.deepseek.com/
# ============================================================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# 火山引擎 API（豆包系列，推理和创意能力强）
# 申请地址：https://console.volcengine.com/ark
# ============================================================
VOLCANO_API_KEY=your-volcano-api-key-here
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 推理接入点 ID（火山引擎用 endpoint_id 作为 model 参数，形如 ep-xxxxxxxx）
VOLCANO_PRO_ENDPOINT=ep-your-volcano-endpoint-id-here

# ============================================================
# 数据目录
# ============================================================
DATA_DIR=data

# ============================================================
# LLM 全局默认配置
# ============================================================
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=8000
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2

# ============================================================
# 上下文管理（token 预算）
# ============================================================
CONTEXT_BUDGET_TOKENS=10500
SUMMARY_MAX_TOKENS=1000
RECENT_CHAPTER_MAX_TOKENS=2000
