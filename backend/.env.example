# NovelWorkshop 后端环境变量配置示例（R5：密钥外置）
# 用法：复制本文件为 config/.env 并填入你自己的真实密钥；.env 不要提交到代码仓库/发布包。
# 本文件仅含占位符，源码（config/settings.py / app/llm/）不内置任何真实密钥。
#
#   cp config/.env.example config/.env   （或在系统环境变量中导出同名变量）
#
# 注意：配置加载见 config/settings.py（pydantic BaseSettings，env_file 指向 config/.env）。

# ============================================================
# DeepSeek API（适合大量文本生成/初稿写作/摘要）
# 申请地址：https://platform.deepseek.com/
# ============================================================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# 火山引擎方舟 API（豆包系列，推理/高阶创意）
# 申请地址：https://console.volcengine.com/ark
# ============================================================
VOLCANO_API_KEY=your-volcano-api-key-here
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 火山推理接入点 ID（方舟控制台创建推理接入点后获得，形如 ep-xxxxxxxx）
# settings.py 中字段名为 volcano_pro_endpoint，对应环境变量 VOLCANO_PRO_ENDPOINT
VOLCANO_PRO_ENDPOINT=ep-your-volcano-endpoint-id-here
# 兼容别名（部分文档写作 VOLCANO_ENDPOINT_ID；若使用别名请与上面保持同值）
VOLCANO_ENDPOINT_ID=ep-your-volcano-endpoint-id-here

# ============================================================
# 数据目录（工作区根，书籍存于 data/workspaces/）
# ============================================================
DATA_DIR=data

# ============================================================
# LLM 全局默认参数
# ============================================================
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=8000
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2

# ============================================================
# 上下文管理（token 预算）
# ============================================================
CONTEXT_BUDGET_TOKENS=10500
SUMMARY_MAX_TOKENS=1000
RECENT_CHAPTER_MAX_TOKENS=2000
