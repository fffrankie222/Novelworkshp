# ===== 密钥与环境配置（绝不提交）=====
.env
.env.*
!.env.example
backend/config/.env
config/.env

# ===== Python 后端 =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ===== 前端依赖与构建产物 =====
node_modules/
dist/
*.local

# ===== 用户创作数据（本地运行时生成，不上传）=====
